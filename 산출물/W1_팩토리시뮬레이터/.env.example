# =============================================================================
# W1 팩토리 시뮬레이터 — 환경변수 예시
#
#   cp .env.example .env   후 값을 채운다.
#   .env 는 절대 저장소에 올리지 않는다(.gitignore 등록됨).
#   코드에는 URL·키를 박지 않는다. 전부 여기서만 읽는다.
#
#   무료 프로젝트 → Pro 전환 시 이 파일의 접속 정보만 바꾸면 된다.
#   (스키마는 db/migrations/*.sql 실행으로 복원)
# =============================================================================

# --- Supabase 접속 (필수) -----------------------------------------------------
# Supabase 대시보드 > Project Settings > Database > Connection string
# 세션 풀러(5432) 또는 트랜잭션 풀러(6543) 중 하나. 아래는 ap-northeast-2 예시 형식.
#   postgresql://postgres.<project-ref>:<DB-PASSWORD>@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres
SUPABASE_DB_URL=

# Project Settings > API. 학생이 Supabase 를 직접 폴링할 때 쓰는 값.
# 서버는 쓰지 않지만 배포 시 함께 관리하려고 둔다.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# --- 강사 콘솔 (필수) ---------------------------------------------------------
# 아무 긴 난수 문자열. 이상 주입·제어 개방·리셋 권한이 걸린다.
INSTRUCTOR_TOKEN=

# --- 시뮬레이션 주기 ----------------------------------------------------------
# 교안 3절이 "1초 주기 변동"으로 못박은 값. 기본을 바꾸지 말 것.
SIM_TICK_SECONDS=1.0
# 배치 적재 주기(초). 리허설에서 지연이 보이면 3~5 로 늘린다(리서치 판단 기준).
SIM_FLUSH_SECONDS=2.0

# --- 보존정책 ----------------------------------------------------------------
# 초당 312행 기준 시간당 약 112MB 가 쌓인다. 무료 티어 DB 는 500MB.
# 2시간 유지가 기본. 하루 4시간 수업이면 이 값으로 충분하다.
RETENTION_HOURS=2
RETENTION_SWEEP_SECONDS=300

# --- 대상 네임스페이스 --------------------------------------------------------
# individual (Day 1~3, S01~S39) | team (Day 4, T1~T8) | both
# individual(S01~S39) | team(T1~T8) | both(둘 다, 47개)
# both 로 두면 Day 4 에 팀 공간을 쓰려고 서버를 재시작할 일이 없다.
# 강사가 기억해야 하는 조작을 줄이는 것이 목적이다.
TENANT_MODE=both
# 개발 중 일부만 돌릴 때 쉼표로 지정. 비우면 TENANT_MODE 전체.
TENANT_FILTER=

# --- 제어 API (교안: Day 4 최초 개방) -----------------------------------------
# 전체 개방 마스터 스위치. 평소 false 로 두고 강사 콘솔에서 테넌트별로 연다.
CONTROL_API_ENABLED=false
# 시뮬레이터가 승인 관문을 강제할 명령. 비우면 즉시 실행.
# 교안 설계상 승인 관문은 학생 오케스트레이터(W6)에 있으므로 기본은 비움.
#   예) HITL_REQUIRED_COMMANDS=stop_equipment,dispatch_robot
HITL_REQUIRED_COMMANDS=

# --- 서버 --------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
DB_POOL_MIN=1
DB_POOL_MAX=8

# 배속 (가상 시계). 비우면 config/sim_profile.json 의 default_time_scale(=60) 을 쓴다.
#   60  실제 1.00초마다 공장 1분치 — 기본값. 교안 3절의 '1초 주기 변동'이 그대로 유지되고
#       적재량도 x1 과 같다. 부록 A 레거시 CSV(1분 격자)와 데이터 격자가 일치한다.
#   1   실시간. 4시간짜리 온도 드리프트를 실제로 4시간 기다려야 하므로 시연·실습에는 못 쓴다.
#   120 공장 4시간이 실제 2분. 적재량이 2배라 팀 모드(8개)에서만 권장.
SIM_TIME_SCALE=
