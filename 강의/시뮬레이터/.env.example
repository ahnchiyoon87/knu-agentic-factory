# =============================================================================
# 공장 설정 — 학생이 손으로 고칠 일이 없는 파일
#
#   cp .env.example .env   (배포본에는 .env 가 이미 들어 있다)
#
#   공장과 DB 는 전부 이 컴퓨터의 docker compose 안에서 돈다. 서버가 없다.
#   DB 접속줄·번호 같은 값은 docker-compose.yml 에 박혀 있다 — 비밀이 아니다.
#   다 같이 쓰는 것은 아래 AI 열쇠 하나뿐이다.
# =============================================================================

# 강사 저장소에서는 평문(sk-)을 넣어 둔다 — 배포본만들기.py 가 학생 .env 에는
# 수업이 끝나면 강사가 OpenAI 대시보드에서 이 키를 지운다 — 그 순간 죽는다.
OPENAI_API_KEY=
DIAGNOSE_MODEL=gpt-5.4-mini

# 2일차는 잠금(false). 3일차 31장의 제어열기.py 가 API 로 연다 — 이 값은 예비 스위치다.
CONTROL_API_ENABLED=false

# 이력 보존(시간). 오래 두면 디스크만 쓴다 — 실습은 1시간이면 충분하다.
RETENTION_HOURS=1
